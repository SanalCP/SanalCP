#!/usr/bin/env bash
# SanalCP -> SanalCP aktarımı için salt-okunur kaynak dışa aktarıcı.
# stdout protokoldür: inventory metin, export ise doğrudan tar.gz akışı üretir.
set -euo pipefail

die(){ echo "sanalcp-transfer-export: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "root gerekli"
command -v mysql >/dev/null 2>&1 || die "mysql istemcisi bulunamadı"

sql(){ mysql --batch --raw --skip-column-names panel -e "$1"; }
domain_ok(){ [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{1,251}[A-Za-z0-9])$ ]] && [[ "$1" == *.* ]] && [[ "$1" != *..* ]]; }
user_ok(){ [[ "$1" =~ ^c_[a-z0-9_]{1,61}$ ]]; }

inventory(){
  echo "PROVIDER=sanalcp"
  version=$(curl -fsS --max-time 2 http://127.0.0.1:8080/healthz 2>/dev/null \
    | sed -n 's/.*"surum":"\([^"]*\)".*/\1/p' || true)
  echo "VERSION=${version:-unknown}"
  sql "SELECT CONCAT('SITE=',LOWER(alan_adi),'|',sistem_kullanici,'|',php_surum) FROM domains WHERE ana_domain_id IS NULL AND durum IN ('aktif','pasif') ORDER BY alan_adi"
}

export_domain(){
  domain=${1,,}
  domain_ok "$domain" || die "geçersiz domain"

  row=$(sql "SELECT id,sistem_kullanici,php_surum FROM domains WHERE LOWER(alan_adi)='$domain' LIMIT 1")
  [ -n "$row" ] || die "domain bulunamadı"
  IFS=$'\t' read -r domain_id sk php_version <<<"$row"
  [[ "$domain_id" =~ ^[0-9]+$ ]] || die "geçersiz domain kimliği"
  user_ok "$sk" || die "güvensiz sistem kullanıcısı"

  work=$(mktemp -d /tmp/sanalcp-transfer.XXXXXX)
  trap 'rm -rf "$work"' EXIT
  root="$work/cpmove-$sk"
  mkdir -p "$root/cp/userdata/$sk" "$root/homedir/public_html" \
    "$root/homedir/etc/$domain" "$root/homedir/mail/$domain" \
    "$root/mysql" "$root/dnszones" "$root/sslcerts" "$root/sslkeys" "$root/va" "$root/sanalcp"
  printf '%s\n' "$sk" > "$root/cp/backup_user"
  printf 'main_domain: %s\nphp_version: %s\nsource_panel: sanalcp\n' \
    "$domain" "$php_version" > "$root/cp/userdata/$sk/main"
  sql "SELECT JSON_OBJECT('version',1,'domain',alan_adi,'source_ipv4',ipv4,'php_version',php_surum) FROM domains WHERE id=$domain_id" \
    > "$root/sanalcp/domain.json"
  sql "SELECT JSON_OBJECT('name',ad,'type',tip,'value',deger,'ttl',ttl,'priority',oncelik,'active',aktif) FROM dns_records WHERE domain_id=$domain_id ORDER BY id" \
    > "$root/sanalcp/dns.jsonl"
  sql "SELECT JSON_OBJECT('local_part',local_part,'password_hash',password_hash,'quota_bytes',quota_bytes,'status',status) FROM mailboxes WHERE domain_id=$domain_id ORDER BY id" \
    > "$root/sanalcp/mailboxes.jsonl"
  sql "SELECT JSON_OBJECT('hotlink_enabled',hotlink_aktif,'hotlink_allowed',COALESCE(hotlink_izinli,''),'ip_access_mode',ip_erisim_modu,'www_redirect',www_yonlendir,'waf_enabled',waf_enabled,'waf_mode',COALESCE(waf_mode,''),'waf_paranoia',COALESCE(waf_paranoia,0)) FROM domains WHERE id=$domain_id" \
    > "$root/sanalcp/security.json"
  sql "SELECT JSON_OBJECT('target_url',hedef_url,'code',kod) FROM domain_redirects WHERE domain_id=$domain_id" \
    > "$root/sanalcp/redirect.json"
  sql "SELECT JSON_OBJECT('cidr',ip_cidr) FROM domain_ip_kurallari WHERE domain_id=$domain_id ORDER BY id" \
    > "$root/sanalcp/ip_rules.jsonl"
  sql "SELECT JSON_OBJECT('x_content_type',hdr_x_content_type,'x_xss',hdr_x_xss,'referrer',hdr_referrer,'permissions',hdr_permissions,'csp_upgrade',hdr_csp_upgrade,'hsts',hdr_hsts,'hsts_max_age',hsts_max_age,'hsts_subdomains',hsts_subdomains,'hsts_preload',hsts_preload,'http3',http3,'cache_profile',cache_profili) FROM nginx_settings WHERE domain_id=$domain_id" \
    > "$root/sanalcp/nginx.json"
  sql "SELECT JSON_OBJECT('profile',profil,'requests_per_minute',istek_dakika,'burst',burst,'block_bots',bot_engelle,'ip_exceptions',COALESCE(ip_istisnalari,''),'path_exceptions',COALESCE(yol_istisnalari,'')) FROM domain_rate_limits WHERE domain_id=$domain_id" \
    > "$root/sanalcp/rate_limit.json"
  sql "SELECT JSON_OBJECT('enabled',enabled,'greylist_score',greylist_score,'add_header_score',add_header_score,'reject_score',reject_score) FROM mail_spam_settings WHERE domain_id=$domain_id" \
    > "$root/sanalcp/mail_spam.json"
  sql "SELECT JSON_OBJECT('local_part',m.local_part,'enabled',a.enabled,'subject',a.subject_text,'body',a.body_text,'interval_days',a.interval_days) FROM mail_autoresponders a JOIN mailboxes m ON m.id=a.mailbox_id WHERE a.domain_id=$domain_id ORDER BY m.local_part" \
    > "$root/sanalcp/autoresponders.jsonl"
  sql "SELECT JSON_OBJECT('local_part',m.local_part,'name',f.name,'match_field',f.match_field,'match_value',f.match_value,'action_type',f.action_type,'action_value',f.action_value,'priority',f.priority_n,'enabled',f.enabled) FROM mail_filters f JOIN mailboxes m ON m.id=f.mailbox_id WHERE f.domain_id=$domain_id ORDER BY m.local_part,f.priority_n,f.id" \
    > "$root/sanalcp/mail_filters.jsonl"
  sql "SELECT JSON_OBJECT('label',alt_ad,'domain',tam_ad,'php_version',php_surum) FROM subdomanlar WHERE domain_id=$domain_id ORDER BY alt_ad" \
    > "$root/sanalcp/subdomains.jsonl"
  sql "SELECT JSON_OBJECT('domain',alan_adi,'parked',parked,'php_version',php_surum) FROM domains WHERE ana_domain_id=$domain_id ORDER BY alan_adi" \
    > "$root/sanalcp/addon_domains.jsonl"
  sql "SELECT JSON_OBJECT('domain',d.alan_adi,'name',r.ad,'type',r.tip,'value',r.deger,'ttl',r.ttl,'priority',r.oncelik,'active',r.aktif) FROM domains d JOIN dns_records r ON r.domain_id=d.id WHERE d.ana_domain_id=$domain_id ORDER BY d.alan_adi,r.id" \
    > "$root/sanalcp/addon_dns.jsonl"

  if [ -d "/home/$sk/public_html" ]; then
    cp -a "/home/$sk/public_html/." "$root/homedir/public_html/"
  fi
  # Bazı uygulamalar sırları web kökü dışında, doğrudan kullanıcı ana
  # dizininde tutar (örn. /home/kullanici/config.local.php). Yalnız düzenli
  # üst-seviye dosyaları taşı; kabuk/SSH/panel kimlikleri hedefe kopyalanmaz.
  mkdir -p "$root/homedir/native_home"
  find "/home/$sk" -mindepth 1 -maxdepth 1 -type f -print0 \
    | while IFS= read -r -d '' home_file; do
        base=${home_file##*/}
        case "$base" in
          .bash_logout|.bash_profile|.bashrc|.bash_history|.profile|.lesshst|.viminfo|.mysql_history|.wget-hsts|authorized_keys) continue ;;
        esac
        cp -a -- "$home_file" "$root/homedir/native_home/$base"
      done
  sql "SELECT tam_ad FROM subdomanlar WHERE domain_id=$domain_id ORDER BY alt_ad" \
    | while IFS= read -r child; do
        [[ "$child" =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ ]] || die "güvensiz alt alan adı"
        [ -d "/home/$sk/subdomains/$child" ] || continue
        mkdir -p "$root/homedir/subdomains/$child"
        cp -a "/home/$sk/subdomains/$child/." "$root/homedir/subdomains/$child/"
      done
  sql "SELECT alan_adi FROM domains WHERE ana_domain_id=$domain_id AND parked=0 ORDER BY alan_adi" \
    | while IFS= read -r child; do
        [[ "$child" =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ ]] || die "güvensiz ek alan adı"
        [ -d "/home/$sk/domains/$child" ] || continue
        mkdir -p "$root/homedir/domains/$child"
        cp -a "/home/$sk/domains/$child/." "$root/homedir/domains/$child/"
      done
  sql "SELECT id,alan_adi,COALESCE(cert_path,''),COALESCE(key_path,'') FROM domains WHERE ana_domain_id=$domain_id ORDER BY alan_adi" \
    | while IFS=$'\t' read -r child_id child cert_path key_path; do
        [[ "$child" =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ ]] || die "güvensiz ek alan adı"
        child_root="$root/sanalcp/addons/$child"
        mkdir -p "$child_root"
        sql "SELECT JSON_OBJECT('hotlink_enabled',hotlink_aktif,'hotlink_allowed',COALESCE(hotlink_izinli,''),'ip_access_mode',ip_erisim_modu,'www_redirect',www_yonlendir,'waf_enabled',waf_enabled,'waf_mode',COALESCE(waf_mode,''),'waf_paranoia',COALESCE(waf_paranoia,0)) FROM domains WHERE id=$child_id" > "$child_root/security.json"
        sql "SELECT JSON_OBJECT('target_url',hedef_url,'code',kod) FROM domain_redirects WHERE domain_id=$child_id" > "$child_root/redirect.json"
        sql "SELECT JSON_OBJECT('cidr',ip_cidr) FROM domain_ip_kurallari WHERE domain_id=$child_id ORDER BY id" > "$child_root/ip_rules.jsonl"
        sql "SELECT JSON_OBJECT('x_content_type',hdr_x_content_type,'x_xss',hdr_x_xss,'referrer',hdr_referrer,'permissions',hdr_permissions,'csp_upgrade',hdr_csp_upgrade,'hsts',hdr_hsts,'hsts_max_age',hsts_max_age,'hsts_subdomains',hsts_subdomains,'hsts_preload',hsts_preload,'http3',http3,'cache_profile',cache_profili) FROM nginx_settings WHERE domain_id=$child_id" > "$child_root/nginx.json"
        sql "SELECT JSON_OBJECT('profile',profil,'requests_per_minute',istek_dakika,'burst',burst,'block_bots',bot_engelle,'ip_exceptions',COALESCE(ip_istisnalari,''),'path_exceptions',COALESCE(yol_istisnalari,'')) FROM domain_rate_limits WHERE domain_id=$child_id" > "$child_root/rate_limit.json"
        if [ -n "$cert_path" ] && [ -n "$key_path" ] && [ -f "$cert_path" ] && [ -f "$key_path" ]; then
          cp "$cert_path" "$child_root/cert.pem"
          cp "$key_path" "$child_root/key.pem"
        fi
      done

  sql "SELECT DISTINCT db_name FROM db_accounts WHERE domain_id=$domain_id ORDER BY db_name" \
    | while IFS= read -r db_name; do
        [ -n "$db_name" ] || continue
        [[ "$db_name" =~ ^[A-Za-z0-9_\$]+$ ]] || die "güvensiz veritabanı adı"
        mysqldump --single-transaction --routines --triggers --events "$db_name" \
          > "$root/mysql/$db_name.sql"
      done

  # Eski kurulumlarda db_accounts kaydı eksik olabilen varsayılan DB'yi de koru.
  default_db=$(sql "SELECT COALESCE(db_adi,'') FROM domains WHERE id=$domain_id")
  if [ -n "$default_db" ] && [[ "$default_db" =~ ^[A-Za-z0-9_\$]+$ ]] \
      && [ ! -f "$root/mysql/$default_db.sql" ]; then
    if sql "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$default_db'" | grep -qx "$default_db"; then
      mysqldump --single-transaction --routines --triggers --events "$default_db" \
        > "$root/mysql/$default_db.sql"
    fi
  fi

  sql "SELECT local_part FROM mailboxes WHERE domain_id=$domain_id ORDER BY local_part" \
    | while IFS= read -r local_part; do
        [[ "$local_part" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$ ]] || continue
        printf '%s:*:1:0:99999:7:::\n' "$local_part" >> "$root/homedir/etc/$domain/shadow"
        [ -d "/home/$sk/mail/$local_part" ] \
          && cp -a "/home/$sk/mail/$local_part" "$root/homedir/mail/$domain/$local_part"
      done
  sql "SELECT source,destination FROM mail_aliases WHERE domain_id=$domain_id AND status='active' ORDER BY source" \
    | while IFS=$'\t' read -r source destination; do
        [ -n "$source" ] && [ -n "$destination" ] && printf '%s: %s\n' "$source" "$destination"
      done > "$root/va/$domain"

  if [ -f "/var/spool/cron/$sk" ]; then
    cp "/var/spool/cron/$sk" "$root/cron"
  fi
  for zone in "/var/named/$domain.zone" "/var/named/$domain.db" "/etc/bind/zones/$domain.zone"; do
    if [ -f "$zone" ]; then cp "$zone" "$root/dnszones/$domain.db"; break; fi
  done

  ssl_row=$(sql "SELECT COALESCE(cert_path,''),COALESCE(key_path,'') FROM domains WHERE id=$domain_id AND ssl_aktif=1")
  if [ -n "$ssl_row" ]; then
    IFS=$'\t' read -r cert_path key_path <<<"$ssl_row"
    if [ -f "$cert_path" ] && [ -f "$key_path" ]; then
      cp "$cert_path" "$root/sslcerts/$domain.crt"
      cp "$key_path" "$root/sslkeys/$domain.key"
    fi
  fi

  tar -C "$work" -czf - "cpmove-$sk"
}

case "${1:-}" in
  inventory) inventory ;;
  export) [ $# = 2 ] || die "kullanım: $0 export DOMAIN"; export_domain "$2" ;;
  *) die "kullanım: $0 inventory | export DOMAIN" ;;
esac
