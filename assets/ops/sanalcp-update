#!/usr/bin/env bash
# sanalcp-update — safely updates SanalCP in-place from GitHub.
#
#   sanalcp-update            # pull latest → swap binary+frontend+migrations → restart
#   sanalcp-update --dry-run  # show what would happen, touch nothing
#   sanalcp-update --force    # re-apply even if the binary is unchanged
#   sanalcp-update --branch X # use a different branch (default: main)
#
# PRESERVES (never touched): /etc/sanalcp/env (JWT/DB/Redis secrets),
# the MariaDB `panel` DB + all customer data, /home/c_* sites.
# New migrations are applied automatically + idempotently when the service restarts.
#
# DB RESILIENCE:
#  • A full dump of the panel DB is taken BEFORE migrations (/var/backups/sanalcp/db).
#  • FAIL-CLOSED: if the dump fails, the update NEVER STARTS (no migration without a backup).
#  • If the new version doesn't come up healthy, rolls back to the OLD binary + pre-update DB.
#  • A daily 03:30 backup timer (sanalcp-db-backup.timer) is installed + enabled.
set -euo pipefail

REPO="${SANAL_REPO:-sanalcp/sanalcp}"
BRANCH="main"; DRY=0; FORCE=0
PREFIX=/opt/sanalcp
BIN="$PREFIX/bin/sanalcp-server"
SEED="$PREFIX/bin/sanalcp-seed-admin"
FDIST="$PREFIX/frontend-dist"
MIGR="$PREFIX/src/migrations"
SCRIPTS="$PREFIX/src/scripts"
DBBK=/usr/local/bin/sanalcp-db-backup   # panel DB dump tool (installed from assets/ops)
DBDIR=/var/backups/sanalcp/db           # where dumps live (sibling dirs = domain backups)
PREDUMP=""                                    # pre-update dump path (restored on rollback)

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --force) FORCE=1 ;;
    --branch) BRANCH="$2"; shift ;;
    --branch=*) BRANCH="${1#*=}" ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

c_b="\033[1;34m"; c_g="\033[32m"; c_r="\033[31m"; c_y="\033[33m"; c_0="\033[0m"
[ -t 1 ] || { c_b=; c_g=; c_r=; c_y=; c_0=; }
ok()   { echo -e "  ${c_g}✓${c_0} $*"; }
warn() { echo -e "  ${c_y}!${c_0} $*"; }
die()  { echo -e "${c_r}✗ $*${c_0}" >&2; exit 1; }
step() { echo -e "${c_b}══ $* ══${c_0}"; }

# This runs both from SSH and from inside the panel (Settings → panel update, which
# shows this script's stdout live) — so its messages follow the PANEL's own default
# language (panel_ayarlari.varsayilan_dil), not a fixed one. DB may not be reachable
# yet (auth_socket, DB down) → falls back to Turkish (project default) silently.
DBLANG=$(mysql -N -B panel -e "SELECT varsayilan_dil FROM panel_ayarlari WHERE id=1;" 2>/dev/null || echo "")
[ "$DBLANG" = "en" ] || DBLANG="tr"
t() { if [ "$DBLANG" = "en" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

# version from the running panel's /healthz (the binary has NO --version flag, we never run it)
surum() { curl -fsS http://127.0.0.1:8080/healthz 2>/dev/null | grep -oE '"surum":"[^"]*"' | cut -d'"' -f4; }

[ "$(id -u)" = 0 ] || die "$(t "root gerekli (sudo sanalcp-update)" "root required (sudo sanalcp-update)")"
[ -x "$BIN" ] || die "$(t "SanalCP kurulu değil ($BIN yok) — önce install.sh çalıştırın" "SanalCP is not installed ($BIN missing) — run install.sh first")"
command -v curl >/dev/null || die "$(t "curl gerekli" "curl required")"
command -v tar  >/dev/null || die "$(t "tar gerekli" "tar required")"

step "$(t "SanalCP güncelleme (github.com/$REPO@$BRANCH)" "SanalCP update (github.com/$REPO@$BRANCH)")"

# 1) download
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
echo "  $(t "indiriliyor…" "downloading…")"
curl -fsSL "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" | tar xz -C "$TMP" \
  || die "$(t "indirme başarısız — repo public mi / '$BRANCH' dalı var mı?" "download failed — is the repo public / does branch '$BRANCH' exist?")"
# GitHub tarball'i TEK bir ust dizin icerir. Dal adina gore eslestirme
# YAPILAMAZ: GitHub dal adindaki "/" karakterini dizin adinda "-" yapar
# (feat/x -> SanalCP-feat-x). Eski desen "*-$BRANCH" idi ve slash iceren her
# dal adinda sessizce "assets/sanalcp-server yok" hatasi veriyordu — yani
# --branch ile guvenli test dagitimi o dallarda hic calismiyordu.
SRC=$(find "$TMP" -mindepth 1 -maxdepth 1 -type d | head -1)
[ -n "$SRC" ] || die "$(t "arsiv bosaltilamadi (ust dizin yok)" "archive extraction produced no top-level directory")"
A="$SRC/assets"
NEWBIN="$A/sanalcp-server"
[ -f "$NEWBIN" ] || die "$(t "$A/sanalcp-server yok (repo yapısı beklenenden farklı)" "$A/sanalcp-server missing (repo layout is not what was expected)")"
[ -f "$A/SHA256SUMS" ] || die "$(t "release bütünlük manifesti yok" "release integrity manifest missing")"
(cd "$SRC" && sha256sum -c assets/SHA256SUMS >/dev/null) ||
  die "$(t "release asset SHA-256 doğrulaması başarısız" "release asset SHA-256 verification failed")"
ok "$(t "release asset bütünlüğü doğrulandı" "release asset integrity verified")"

# Aile tespiti + paket adları: İNDİRİLEN release'ten source edilir, kurulu
# kopyadan değil. Eski bir sunucuda /usr/local/bin/sanalcp-ortak henüz yoktur
# (adım 9'da kurulacak), ama bu betiğin paket kurma adımları ondan ÖNCE geçer.
if [ -f "$A/ops/sanalcp-ortak.sh" ]; then
  # shellcheck source=/dev/null
  . "$A/ops/sanalcp-ortak.sh"
else
  # Çok eski bir release'e geri dönülüyorsa (ortak.sh yok) RHEL varsayımıyla devam et.
  debian_mi(){ return 1; }; rhel_mi(){ return 0; }
  pkg_kur(){ dnf install -y "$@" >/dev/null 2>&1; }
  paket_ad(){ case "$1" in kota-ext) echo quota ;; kota-xfs) echo xfsprogs ;; *) echo "$1" ;; esac; }
fi

# 2) verify the new binary WITHOUT running it (ELF header) + detect changes.
# IMPORTANT: hash the WHOLE release (binary + frontend-dist + migrations), not just the
# binary. Otherwise a frontend-only / migration-only update would be wrongly SKIPPED
# because the binary sha stayed the same.
# sigpipe-ok: head 4 bayt yazıp çıkar, SIGPIPE oluşmaz
head -c4 "$NEWBIN" | grep -q $'\x7fELF' || die "$(t "indirilen binary geçerli ELF değil — iptal" "downloaded binary is not a valid ELF — aborting")"  # sigpipe-ok
CURVER=$(surum); [ -n "$CURVER" ] || CURVER="?"
echo "  $(t "mevcut sürüm: $CURVER" "current version: $CURVER")"
# NOTE: reduce every sha256sum to ONLY the hash with cut — otherwise the (random tmp)
# file path in the output would change RELHASH on every run, and the no-op path would
# never trigger.
RELHASH=$( { sha256sum "$NEWBIN" | cut -d' ' -f1
  [ -f "$A/frontend-dist.tar.gz" ] && sha256sum "$A/frontend-dist.tar.gz" | cut -d' ' -f1
  [ -f "$A/migrations.tar.gz" ] && sha256sum "$A/migrations.tar.gz" | cut -d' ' -f1
  # ops/ + systemd/ are INCLUDED in the hash too: otherwise a release that only changes
  # a script/unit (e.g. adding the DB backup tool + timer) would leave RELHASH unchanged
  # and the update would silently report "already up to date" — the fix would never
  # reach the server.
  # LC_ALL=C sort: file order must be deterministic, or the hash would drift each run.
  find "$A/ops" "$A/systemd" -type f 2>/dev/null | LC_ALL=C sort \
    | xargs -r sha256sum 2>/dev/null | cut -d' ' -f1
  true; } | sha256sum | cut -d' ' -f1)
MARKER="$PREFIX/.release_hash"
CURREL=$(cat "$MARKER" 2>/dev/null || echo yok)
if [ "$RELHASH" = "$CURREL" ] && [ "$FORCE" = 0 ]; then
  ok "$(t "zaten en güncel (release hash eşleşti) — yapılacak bir şey yok (--force ile zorla)" "already up to date (release hash matched) — nothing to do (use --force to override)")"
  exit 0
fi

if [ "$DRY" = 1 ]; then
  step "$(t "DRY-RUN — değişecekler (uygulanmadı)" "DRY RUN — what would change (nothing applied)")"
  echo "  • $BIN  $(t "(binary değişmişse swap + yedek $BIN.bak)" "(swapped if changed + backed up to $BIN.bak)")"
  echo "  • $FDIST/  $(t "(frontend-dist yeniden yazılır)" "(frontend-dist rewritten)")"
  echo "  • $MIGR/  $(t "(yeni .sql eklenir; mevcut dizin ${MIGR}.bak olarak yedeklenir → rollback geri yükler)" "(new .sql files added; current directory backed up as ${MIGR}.bak → restored on rollback)")"
  echo "  • $(t "/usr/local/bin ops-tool'lar" "/usr/local/bin ops tools")" "+ $SCRIPTS"
  echo "  • $DBBK + /etc/systemd/system/sanalcp-db-backup.{service,timer} $(t "(timer enable --now)" "(timer enable --now)")"
  echo "  • $(t "migration'lardan ÖNCE panel DB dump'ı → $DBDIR  (DRY-RUN'da dump ALINMAZ)" "panel DB dump BEFORE migrations → $DBDIR  (no dump is taken in DRY RUN)")"
  echo "  • systemctl restart sanalcp  $(t "(env/DB/siteler KORUNUR)" "(env/DB/sites PRESERVED)")"
  exit 0
fi

# 3) install the DB backup tool + daily timer.
# ORDER MATTERS: we take the dump in step 4, so the tool must already be INSTALLED. The
# general ops loop in step 9 runs too late (migrations would already be open by step 6)
# and on old installs that never had the tool, the dump would be impossible. Only
# db-backup is installed here — we don't overwrite the running updater's own file at
# this point (bash reads the script line by line; rewriting yourself mid-run is
# dangerous), that happens in step 9.
if [ -f "$A/ops/sanalcp-db-backup" ]; then
  install -m 0755 "$A/ops/sanalcp-db-backup" "$DBBK"
  ok "$(t "DB yedek aracı kuruldu ($DBBK)" "DB backup tool installed ($DBBK)")"
fi
# systemd units: copying the file is NOT enough — without daemon-reload + enable --now
# the timer never fires (if forgotten, the daily backup would silently never run).
UNITS=0
for u in sanalcp-db-backup.service sanalcp-db-backup.timer; do
  if [ -f "$A/systemd/$u" ]; then install -m 0644 "$A/systemd/$u" "/etc/systemd/system/$u"; UNITS=1; fi
done
if [ "$UNITS" = 1 ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now sanalcp-db-backup.timer >/dev/null 2>&1 || true
  if systemctl is-active --quiet sanalcp-db-backup.timer; then
    ok "$(t "günlük DB yedek timer'ı ACTIVE ($(systemctl show -p TimersCalendar --value sanalcp-db-backup.timer 2>/dev/null | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}' | head -1))" "daily DB backup timer ACTIVE ($(systemctl show -p TimersCalendar --value sanalcp-db-backup.timer 2>/dev/null | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}' | head -1))")"
  else
    warn "$(t "DB yedek timer'ı başlatılamadı — günlük yedek çalışmayabilir" "DB backup timer failed to start — daily backup may not run")"
  fi
fi

# 4) PRE-UPDATE DB DUMP — FAIL-CLOSED.
# Migrations can't be undone; a migration without a backup is unacceptable. If the dump
# fails, do NOT start the update at all (nothing touched — binary, frontend, migrations).
step "$(t "Güncelleme öncesi DB yedeği" "Pre-update DB backup")"
[ -x "$DBBK" ] || die "$(t "DB yedek aracı yok/çalıştırılamıyor ($DBBK) — yedeksiz migration REDDEDİLDİ, güncelleme başlatılmadı" "DB backup tool missing/unusable ($DBBK) — migration without a backup REJECTED, update not started")"
PREDUMP=$("$DBBK") || die "$(t "güncelleme öncesi DB yedeği BAŞARISIZ — güncelleme başlatılmadı (DB'ye/binary'ye dokunulmadı)" "pre-update DB backup FAILED — update not started (DB/binary untouched)")"
[ -n "$PREDUMP" ] && [ -f "$PREDUMP" ] \
  || die "$(t "güncelleme öncesi DB yedeği doğrulanamadı (dönen yol boş veya dosya yok) — güncelleme başlatılmadı" "pre-update DB backup could not be verified (returned path empty or missing) — update not started")"
ok "$(t "pre-update dump: $PREDUMP ($(du -h "$PREDUMP" 2>/dev/null | cut -f1))" "pre-update dump: $PREDUMP ($(du -h "$PREDUMP" 2>/dev/null | cut -f1))")"

# 5) backup (binary + seed)
cp -f "$BIN" "$BIN.bak"
[ -x "$SEED" ] && cp -f "$SEED" "$SEED.bak" 2>/dev/null || true
ok "$(t "mevcut binary yedeklendi ($BIN.bak)" "current binary backed up ($BIN.bak)")"

# 6) binary swap (install = atomic replace; the running process keeps the old inode until
# restart — never use cp -f here)
install -m 0755 "$NEWBIN" "$BIN"
[ -f "$A/sanalcp-seed-admin" ] && install -m 0755 "$A/sanalcp-seed-admin" "$SEED"
ok "$(t "binary güncellendi" "binary updated")"

# 7) frontend-dist — ATOMIC + VERIFIED swap.
# Old bug: `rm -rf "${FDIST:?}/"* && tar xzf ...` deleted the running frontend FIRST; if
# extraction was interrupted or a reboot hit before the flush → 0-byte files → WHITE
# SCREEN outage (no way back). Now the new version is extracted into a separate temp
# dir, VERIFIED, then swapped in atomically with mv. A broken/truncated extraction NEVER
# touches the running frontend.
if [ -f "$A/frontend-dist.tar.gz" ]; then
  FDNEW="${FDIST}.new.$$"
  # Cleanup on a broken extraction: remove the temp dir + restore the binary (swapped in
  # step 6) back to the backup, so a failed update is a full no-op on disk too. The
  # service hasn't been restarted yet (that's step 11) → the running panel stays up
  # without interruption on the old binary + old frontend.
  fdist_abort() {
    rm -rf "$FDNEW" 2>/dev/null || true
    install -m 0755 "$BIN.bak" "$BIN" 2>/dev/null || true
    [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
    command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true
    die "$1"
  }
  rm -rf "$FDNEW"; mkdir -p "$FDNEW"
  if ! tar xzf "$A/frontend-dist.tar.gz" -C "$FDNEW"; then
    fdist_abort "$(t "frontend-dist extraction başarısız — mevcut frontend + eski binary KORUNDU" "frontend-dist extraction failed — current frontend + old binary PRESERVED")"
  fi
  # integrity gate: index.html must be non-empty + at least one JS bundle must exist
  # (0-byte/truncated tarballs are rejected)
  if [ ! -s "$FDNEW/index.html" ] || ! ls "$FDNEW"/assets/index-*.js >/dev/null 2>&1; then
    fdist_abort "$(t "frontend-dist bozuk (index.html/JS boş veya eksik) — mevcut frontend + eski binary KORUNDU" "frontend-dist is broken (index.html/JS empty or missing) — current frontend + old binary PRESERVED")"
  fi
  rm -rf "${FDIST}.old"
  [ -d "$FDIST" ] && mv "$FDIST" "${FDIST}.old"
  mv "$FDNEW" "$FDIST"
  sync   # reboot-safe: flush to disk to avoid delayed-alloc data loss
  ok "$(t "frontend-dist güncellendi (atomik doğrulanmış swap)" "frontend-dist updated (atomic, verified swap)")"
fi

# 8) migrations (idempotent — applied at startup). We already took the dump in step 4.
# A FULL COPY IS TAKEN BEFORE EXTRACTION. If a rollback restores the binary and the DB but
# NOT the migration FILES, the panel CANNOT COME UP: runMigrations stores the sha256 of every
# applied migration in schema_migrations; restoring the DB rewinds that ledger, but if the
# NEW files are still on disk the runner reports "content changed" and log.Fatalf's — so the
# OLD binary hits the same wall. This is exactly what happened in 0.7.0: a recoverable
# rollback turned into a full outage. tar -C MERGES files (it never deletes), so the restore
# must REPLACE the whole directory.
if [ -f "$A/migrations.tar.gz" ]; then
  rm -rf "${MIGR}.bak"
  [ -d "$MIGR" ] && cp -a "$MIGR" "${MIGR}.bak"
  mkdir -p "$MIGR"; tar xzf "$A/migrations.tar.gz" -C "$MIGR"
  ok "$(t "migration'lar senkron ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) sql)" "migrations in sync ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) sql)")"
fi

# 9) ops tools (the updater updates itself too; db-backup was already installed in step 3
# — reinstalling here is idempotent)
if [ -d "$A/ops" ]; then
  for t2 in "$A"/ops/*; do bn=$(basename "$t2"); install -m 0755 "$t2" "/usr/local/bin/${bn%.sh}" 2>/dev/null || true; done
  mkdir -p "$SCRIPTS"; cp "$A"/ops/* "$SCRIPTS/" 2>/dev/null || true
  ok "$(t "ops-tool'lar güncellendi" "ops tools updated")"
fi

# 9a) nginx conf'lari — _default80/_default443/php-fpm. Bunlar eskiden SADECE kurulumda
# yaziliyordu, dolayisiyla conf'a giren hicbir duzeltme mevcut kurulumlara inmiyordu.
# _panel.conf BURADA YOK: onu panel kendisi binary'ye gomulu kanonik surumden gunceller
# (bkz. internal/nginxconf + provisioner.HealPanelVhostOnStartup) — orada hash kapisi
# admin'in elle duzenledigi dosyayi korur, burada boyle bir koruma olmazdi.
# nginx -t GATE + rollback: bozuk conf asla kalici olmaz.
if [ -d "$A/nginx" ]; then
  NGBK=$(mktemp -d); NGCHANGED=0
  for f in _default80.conf _default443.conf php-fpm.conf; do
    [ -f "$A/nginx/$f" ] || continue
    if ! cmp -s "$A/nginx/$f" "/etc/nginx/conf.d/$f"; then
      [ -f "/etc/nginx/conf.d/$f" ] && cp "/etc/nginx/conf.d/$f" "$NGBK/$f"
      cp "$A/nginx/$f" "/etc/nginx/conf.d/$f"; NGCHANGED=1
    fi
  done
  if [ "$NGCHANGED" = 1 ]; then
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx >/dev/null 2>&1 || true
      ok "$(t "nginx conf'lari güncellendi" "nginx confs updated")"
    else
      for f in "$NGBK"/*; do [ -e "$f" ] && cp "$f" "/etc/nginx/conf.d/$(basename "$f")"; done
      nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
      warn "$(t "nginx conf güncellemesi nginx -t'den geçmedi, geri alındı" "nginx conf update failed nginx -t, rolled back")"
    fi
  fi
  rm -rf "$NGBK"
fi

# 9b) WAF (ModSecurity + OWASP CRS) heal — IDEMPOTENT (skips in seconds if everything is
# already ready). Rebuilds the connector for ABI if the nginx version changed. Includes an
# nginx -t GATE + rollback → never breaks the main nginx. If the module isn't loaded, the
# panel's WAF gracefully skips (sites are unaffected).
if command -v sanalcp-waf-setup >/dev/null 2>&1; then
  sanalcp-waf-setup >/dev/null 2>&1 && ok "$(t "WAF altyapısı senkron (ModSecurity+CRS)" "WAF stack in sync (ModSecurity+CRS)")" || warn "$(t "waf-setup atlandı (WAF modülsüz graceful)" "waf-setup skipped (gracefully, WAF module unavailable)")"
fi

# 10) isolation + tool prerequisites (added if missing on old installs; idempotent) + SELinux context
command -v bwrap >/dev/null 2>&1 || pkg_kur bubblewrap || true
# acl (setfacl): REQUIRED for the per-user file permission model (nginx user-ACL) —
# without it the panel falls back fail-safe to group=nginx mode. Idempotent.
command -v setfacl >/dev/null 2>&1 || pkg_kur acl || true
# lftp + sshpass: off-site yedek hedefleri (FTP/SFTP) için gerekli — eski
# kurulumlarda eksikti (install script'te yoktu), backup destination özelliği
# sessizce başarısız oluyordu. Idempotent.
command -v lftp >/dev/null 2>&1 || pkg_kur lftp || true
command -v sshpass >/dev/null 2>&1 || pkg_kur sshpass || true
# RAR extractor (file manager .rar extract) — PRIMARY: bsdtar (libarchive, reliably reads
# RAR/RAR5 and itself rejects path-traversal). 7z (7-Zip 26.02) does NOT include the RAR
# codec → unusable.
if ! command -v bsdtar >/dev/null 2>&1 && ! command -v unar >/dev/null 2>&1 && ! command -v unrar >/dev/null 2>&1; then
  pkg_kur "$(paket_ad bsdtar)" || pkg_kur unar || pkg_kur unrar || true
fi
command -v restorecon >/dev/null && restorecon -R "$PREFIX/bin" "$FDIST" >/dev/null 2>&1 || true

# Roundcube SMTP config heal — 🔴 LIVE BUG: webmail could receive but not SEND
# ("SMTP sorunu (): Kimlik doğrulanamadı"). The old template used the Roundcube
# <=1.4 option names (`smtp_server`/`smtp_port`), which 1.7 IGNORES → Roundcube
# fell back to the default plaintext localhost:587. Postfix serves submission
# with `smtpd_tls_security_level=encrypt`, so AUTH is only advertised AFTER
# STARTTLS → the client never saw AUTH and reported an auth failure.
#
# Existing installs never re-run sanalcp-mail-setup.sh, so patch in place.
# Idempotent: only appends when `smtp_host` is absent.
RCCFG=/opt/roundcube/config/config.inc.php
if [ -f "$RCCFG" ] && ! grep -q "smtp_host" "$RCCFG"; then
  cat >> "$RCCFG" <<'RCEOF'

// --- SanalCP onarımı: Roundcube 1.5+ seçenek adları + submission STARTTLS ---
// Eski şablon `smtp_server`/`smtp_port` yazıyordu; 1.7 bunları yok sayar.
// `tls://` olmadan Postfix AUTH'u duyurmaz (submission encrypt zorunlu).
$config['imap_host'] = 'localhost:143';
$config['smtp_host'] = 'tls://localhost:587';
$config['smtp_user'] = '%u';
$config['smtp_pass'] = '%p';
// Loopback'te sertifika ADI uyuşmaz (cert sunucu adına, bağlantı localhost'a);
// trafik makineden çıkmadığı için ad doğrulaması gevşetilir, şifreleme kalır.
$config['smtp_conn_options'] = [
    'ssl' => [
        'verify_peer'       => false,
        'verify_peer_name'  => false,
        'allow_self_signed' => true,
    ],
];
RCEOF
  systemctl reload php-fpm >/dev/null 2>&1 || systemctl restart php-fpm >/dev/null 2>&1 || true
  ok "$(t "webmail SMTP ayarı onarıldı (giden e-posta kimlik doğrulaması)" "webmail SMTP settings repaired (outgoing mail authentication)")"
fi

# 10b) Disk quota GRUB config — 🔴 LIVE SERVER: DO NOT AUTO-REBOOT.
# XFS needs rootflags=uquota, ext2/3/4 needs rootflags=usrquota. `grubby` is run
# on EVERY repair while quota is inactive: /etc/default/grub may already carry
# the flag while a newly installed BLS kernel entry does not (seen live on EL10).
command -v quota >/dev/null 2>&1 || pkg_kur "$(paket_ad kota-ext)" "$(paket_ad kota-xfs)" || true
QROOTFS=$(findmnt -no FSTYPE / 2>/dev/null || echo "")
QROOTOPTS=$(findmnt -no OPTIONS / 2>/dev/null || echo "")
QSENTINEL=/etc/sanalcp/reboot-required-quota
case "$QROOTFS" in
  xfs) QFLAG=rootflags=uquota ;;
  ext2|ext3|ext4) QFLAG=rootflags=usrquota ;;
  *) QFLAG= ;;
esac
if [ -n "$QFLAG" ] && ! echo "$QROOTOPTS" | grep -qwE 'usrquota|uquota|quota'; then  # sigpipe-ok: echo builtin
  if ! grep -q "$QFLAG" /etc/default/grub 2>/dev/null; then
    if grep -q '^GRUB_CMDLINE_LINUX=' /etc/default/grub 2>/dev/null; then
      sed -i "s/^\(GRUB_CMDLINE_LINUX=\"[^\"]*\)\"/\1 $QFLAG\"/" /etc/default/grub
    else
      echo "GRUB_CMDLINE_LINUX=\"$QFLAG\"" >> /etc/default/grub
    fi
  fi
  command -v grubby >/dev/null 2>&1 && grubby --update-kernel=ALL --args="$QFLAG" >/dev/null 2>&1 || true
  command -v grub2-mkconfig >/dev/null 2>&1 && grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || true
  for cfg in /boot/efi/EFI/*/grub.cfg; do [ -f "$cfg" ] && grub2-mkconfig -o "$cfg" >/dev/null 2>&1 || true; done
  mkdir -p /etc/sanalcp
  echo "$QFLAG $(t "GRUB'a yazildi" "written to GRUB") $(date -Is 2>/dev/null) — $(t "reboot bekleniyor" "reboot pending")" > "$QSENTINEL" 2>/dev/null || true
  warn "$(t "🔴 Disk kotası GRUB'a yazıldı — AKTİF olması için tek seferlik REBOOT gerekli (canlı sunucuda operatör zamanlar). OTO-REBOOT YAPILMADI." "🔴 Disk quota was written to GRUB — needs a ONE-TIME REBOOT to become active (the operator schedules this on a live server). NO AUTO-REBOOT was performed.")"
elif [ -n "$QFLAG" ]; then
  [ -f "$QSENTINEL" ] && rm -f "$QSENTINEL" 2>/dev/null && ok "$(t "disk kotası aktif — reboot sentinel temizlendi" "disk quota active — reboot sentinel cleared")" || ok "$(t "disk kotası aktif (kök XFS user quota)" "disk quota active (root XFS user quota)")"
fi

# ext kotasında quotaon her açılışta çalışmalıdır. Bu birimi updater da yazar;
# eski kurulumlar tam installer yeniden çalıştırmadan kendini onarabilsin.
QEXT=0
case "$QROOTFS" in ext2|ext3|ext4) QEXT=1 ;; esac
if [ "$QEXT" = 1 ] && command -v quotacheck >/dev/null 2>&1; then
  cat > /etc/systemd/system/sanalcp-quotacheck.service <<'QCEOF'
[Unit]
Description=SanalCP — ext quota accounting files (once) + enforcement (every boot)
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/sbin/modprobe quota_v2
ExecStart=/bin/sh -c '[ -f /aquota.user ] || /usr/sbin/quotacheck -cum /'
ExecStart=/bin/sh -c '/usr/sbin/quotaon -u / 2>/dev/null || true'

[Install]
WantedBy=local-fs.target
QCEOF
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable sanalcp-quotacheck.service >/dev/null 2>&1 || true
fi

# 10c) Shell history hardening — the panel login IS the server's root password, so
# operators handle it in a root shell all the time. The distro default
# (HISTCONTROL=ignoredups) still records every unique line, so a password pasted at a
# prompt that was not reading a password persists in ~/.bash_history in cleartext.
# `ignoreboth` adds `ignorespace` (leading space = never written to history).
# Installed here too, not just in the installer: EXISTING installs never re-run
# sanalcp-install.sh, so an installer-only fix would reach nobody. Idempotent.
HISTDROP=/etc/profile.d/sanalcp-history.sh
if ! grep -q 'HISTCONTROL=ignoreboth' "$HISTDROP" 2>/dev/null; then
  install -d -m 0755 /etc/profile.d
  cat > "$HISTDROP" <<'HISTEOF'
# SanalCP: commands starting with a SPACE are kept out of shell history
# (ignorespace) + repeated commands collapse to one entry (ignoredups).
# When you must paste a password or token into the shell, prefix the line
# with a space so it is never persisted to ~/.bash_history.
export HISTCONTROL=ignoreboth
HISTEOF
  chmod 0644 "$HISTDROP"
  ok "$(t "kabuk geçmişi sertleştirildi (HISTCONTROL=ignoreboth)" "shell history hardened (HISTCONTROL=ignoreboth)")"
fi

# 11) restart + health check (rolls back binary + DB on failure)
step "$(t "Yeniden başlatılıyor" "Restarting")"
systemctl restart sanalcp
HEALTHY=0
for i in 1 2 3 4 5 6; do
  sleep 2
  if systemctl is-active --quiet sanalcp && curl -fsS http://127.0.0.1:8080/healthz >/dev/null 2>&1; then HEALTHY=1; break; fi
done

if [ "$HEALTHY" = 1 ]; then
  systemctl reload nginx >/dev/null 2>&1 || true
  echo "$RELHASH" > "$MARKER" 2>/dev/null || true   # mark this release as applied
  NEWVER=$(surum); [ -n "$NEWVER" ] || NEWVER="?"
  ok "$(t "panel ACTIVE + /healthz OK" "panel ACTIVE + /healthz OK")"
  ok "$(t "kaynak limitleri planlardan uygulanıyor + mevcut siteler per-tenant PHP-FPM izolasyonuna GÜVENLE (self-check + auto-rollback) geçiriliyor (arka planda)" "resource limits are being applied from plans + existing sites are being SAFELY migrated to per-tenant PHP-FPM isolation (self-check + auto-rollback) in the background")"
  echo -e "${c_g}══ $(t "Güncelleme tamam ($CURVER → $NEWVER) — env/DB/siteler korundu" "Update complete ($CURVER → $NEWVER) — env/DB/sites preserved") ══${c_0}"
else
  warn "$(t "yeni sürüm sağlıklı başlamadı — ESKİ binary'ye + güncelleme öncesi DB'ye dönülüyor" "the new version did not come up healthy — rolling back to the OLD binary + pre-update DB")"
  install -m 0755 "$BIN.bak" "$BIN"
  [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true

  # Restore the migration FILES too (see step 8). The DB is about to be rewound to its
  # pre-update state; the migrations on disk must belong to that same moment, otherwise the
  # checksum ledger and the disk disagree and the OLD binary won't start either.
  if [ -d "${MIGR}.bak" ]; then
    rm -rf "${MIGR:?}"
    cp -a "${MIGR}.bak" "$MIGR"
    sync
    ok "$(t "migration dosyaları güncelleme öncesine döndürüldü ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) sql)" "migration files restored to their pre-update state ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) sql)")"
  else
    warn "$(t "migration yedeği yok — diskteki migration'lar YENİ sürümden kalma olabilir" "no migration backup — the migrations on disk may be left over from the NEW version")"
  fi

  # Restore the DB too: the new version's migration may have changed the schema, and the
  # OLD binary can't run against that schema → a binary-only rollback isn't enough. The
  # panel is currently STOPPED (the restart came up unhealthy) → no write loss during
  # restore.
  # NOTE: the dump was taken with `--databases panel` → it contains DROP+CREATE for every
  # table; tables ADDED by the new migration aren't in the dump, so they REMAIN (the old
  # binary doesn't see them, harmless). Column/data changes are reverted.
  systemctl stop sanalcp >/dev/null 2>&1 || true
  if [ -n "$PREDUMP" ] && [ -f "$PREDUMP" ]; then
    if zcat "$PREDUMP" | mysql; then
      ok "$(t "DB güncelleme öncesi yedeğe geri yüklendi ($PREDUMP)" "DB restored to the pre-update backup ($PREDUMP)")"
    else
      warn "$(t "DB geri yükleme BAŞARISIZ — dump duruyor, elle: zcat '$PREDUMP' | mysql" "DB restore FAILED — the dump is still there, restore manually: zcat '$PREDUMP' | mysql")"
    fi
  else
    warn "$(t "güncelleme öncesi dump bulunamadı — yalnızca binary geri alındı" "pre-update dump not found — only the binary was rolled back")"
  fi

  systemctl restart sanalcp; sleep 3
  if systemctl is-active --quiet sanalcp; then
    die "$(t "rollback yapıldı — panel ESKİ sürüm + ESKİ DB ile ayakta. Yeni sürüm hatası: journalctl -u sanalcp -n 40" "rollback complete — the panel is up on the OLD version + OLD DB. For the new version's error: journalctl -u sanalcp -n 40")"
  else
    die "$(t "KRİTİK: rollback sonrası da panel kalkmadı — journalctl -u sanalcp -n 40 (DB yedeği: $PREDUMP)" "CRITICAL: the panel did not come up even after rollback — journalctl -u sanalcp -n 40 (DB backup: $PREDUMP)")"
  fi
fi
