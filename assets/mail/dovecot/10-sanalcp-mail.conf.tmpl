# SanalCP — Postfix/Dovecot sanal posta kutuları (bkz. internal/mail paketi).
# Tek yeni drop-in dosyası olarak eklenir (stok 10-*.conf dosyaları elle düzenlenmez) —
# /etc/dovecot/dovecot.conf zaten "!include conf.d/*.conf" ile bunu otomatik yükler,
# bu yüzden idempotent kurulum/kaldırma tek dosyayı kopyalamak/silmek kadar basit.
protocols = imap lmtp

mail_location = maildir:~/

# 🔴 Stok 10-auth.conf'taki `!include auth-system.conf.ext` KAPATILMALIDIR
# (kurulum script'i ve panel açılışındaki HealDovecotAuth bunu yapar).
# Dovecot conf.d'yi alfabetik yükler; stok dosya bundan ÖNCE gelip
# `passdb { driver = pam }` kaydeder. passdb'ler sırayla denendiği için her
# sanal kutu girişi önce PAM'a sorulur, kullanıcı sistemde olmadığından
# pam_unix gecikme uygular → giriş ~2 saniye sürer. Ayrıca PAM açıkken IMAP
# üzerinden `root` dahil sistem hesaplarına parola denenebilir.
passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

# Kimlik doğrulama önbelleği: Roundcube her HTTP isteğinde YENİ IMAP oturumu
# açar; önbellek olmadan her istek yeniden passdb sorgusu demektir.
auth_cache_size = 10M
auth_cache_ttl = 1 hours
auth_cache_negative_ttl = 1 mins

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0660
    user = postfix
    group = postfix
  }
}

# Pigeonhole/Sieve: panelin ürettiği kutu-başı filtre ve vacation betiği.
protocol lmtp {
  mail_plugins = $mail_plugins sieve
}
plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_vacation_min_period = 1d
  sieve_vacation_default_period = 7d
  sieve_vacation_max_period = 30d
}

# Varsayılan sertifika: panelin kendi self-signed sertifikası (kurulumda zaten üretiliyor).
# Belirli bir müşteri domaininde gerçek Let's Encrypt sertifikasıyla IMAP/webmail sunmak
# istersen bir local_name { } bloğuyla /etc/pki/sanalcp/<domain>/... yoluna SNI
# override ekleyebilirsin (bkz. plan §2b) — v1'de yalnızca tek varsayılan sertifika var.
ssl_cert = </etc/ssl/sanalcp/panel.crt
ssl_key = </etc/ssl/sanalcp/panel.key
