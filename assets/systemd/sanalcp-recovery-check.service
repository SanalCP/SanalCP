[Unit]
Description=SanalCP monthly backup restore drill
After=mariadb.service sanalcp.service
Wants=mariadb.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sanalcp-recovery-check --restore-drill --json
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
# nginx -t mevcut vhost log hedeflerini açarak doğrular; strict /var'ı da salt
# okunur yaptığı için sağlam nginx yapılandırmasını yanlış-negatif gösterir.
# full, /usr ve /etc'yi korurken nginx'in /var/log doğrulamasına izin verir.
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
