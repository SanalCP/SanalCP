[Unit]
Description=SanalCP backend
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/sanalcp/env
ExecStart=/opt/sanalcp/bin/sanalcp-server
Restart=on-failure
RestartSec=3
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sanalcp

[Install]
WantedBy=multi-user.target
