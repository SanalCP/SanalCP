# SanalCP yerel ortam şablonu — GERÇEK SIR KOYMAYIN.
# Kopyalayıp doldurmak yerine /etc/sanalcp/env kullanın (bkz. .env.local).
#
# Zorunlu:
#   PANEL_DB_DSN=panel:PAROLA@unix(/run/mysqld/mysqld.sock)/panel
#   PANEL_JWT_SECRET=<openssl rand -base64 48 ile üretin, en az 32 karakter>
#   PANEL_SECRET_KEY=<openssl rand -base64 48 ile üretin, en az 32 karakter>
#
# İsteğe bağlı:
#   PANEL_LISTEN=:8080
#   PANEL_CLI_LISTEN=127.0.0.1:8090
#   PANEL_ENV=production
#   PANEL_SURUM_KONTROL=1
#   PANEL_PUBLIC_IPV4=
#   PANEL_SEED_PAROLA=
